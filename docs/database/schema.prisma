// Prisma Schema for DBS Global University Portal (DBS-Camu Next)
// Datasource & Generator

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  FACULTY
  HOD
  DEAN
  REGISTRAR_ADMIN
  EXAM_CONTROLLER

  @@map("user_role")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_DUTY
  MEDICAL_LEAVE
  EXEMPTED

  @@map("attendance_status")
}

enum LeaveStatus {
  PENDING
  RECOMMENDED_BY_MENTOR
  APPROVED_BY_HOD
  APPROVED
  REJECTED
  WITHDRAWN
  NEEDS_CORRECTION

  @@map("leave_status")
}

enum NoticeStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
  CANCELLED

  @@map("notice_status")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY

  @@map("day_of_week")
}

enum AssignmentSubmissionStatus {
  PENDING
  SUBMITTED_ON_TIME
  SUBMITTED_LATE
  GRADED
  MISSED

  @@map("assignment_submission_status")
}

enum FeePaymentStatus {
  DRAFT
  ISSUED
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED

  @@map("fee_payment_status")
}


model Department {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  programs    Program[]
  faculty     FacultyProfile[]
  courses     Course[]
  notices     Notice[]
  tickets     SupportTicket[]
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("departments")
}

model Program {
  id                 String     @id @default(uuid())
  departmentId       String     @map("department_id")
  department         Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code               String     @unique
  name               String
  durationSemesters  Int        @default(8) @map("duration_semesters")
  degreeLevel        String     @map("degree_level")
  batches            Batch[]
  notices            Notice[]
  createdAt          DateTime   @default(now()) @map("created_at")

  @@map("programs")
}

model Batch {
  id              String      @id @default(uuid())
  programId       String      @map("program_id")
  program         Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  startYear       Int         @map("start_year")
  endYear         Int         @map("end_year")
  batchName       String      @map("batch_name")
  currentSemester Int         @default(1) @map("current_semester")
  isActive        Boolean     @default(true) @map("is_active")
  sections        Section[]
  students        StudentProfile[]
  notices         Notice[]
  createdAt       DateTime    @default(now()) @map("created_at")

  @@unique([programId, startYear, endYear])
  @@map("batches")
}

model Section {
  id              String           @id @default(uuid())
  batchId         String           @map("batch_id")
  batch           Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name            String
  students        StudentProfile[]
  courseOfferings CourseOffering[]
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([batchId, name])
  @@map("sections")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  fullName           String              @map("full_name")
  phone              String?
  avatarUrl          String?             @map("avatar_url")
  role               UserRole            @default(STUDENT)
  passwordHash       String              @map("password_hash")
  isActive           Boolean             @default(true) @map("is_active")
  lastLoginAt        DateTime?           @map("last_login_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @default(now()) @map("updated_at")

  sessions           Session[]
  studentProfile     StudentProfile?
  facultyProfile     FacultyProfile?
  mentoredStudents   StudentProfile[]    @relation("FacultyMentor")
  taughtOfferings    CourseOffering[]    @relation("CourseTeacher")
  enrollments        Enrollment[]
  markedSessions     AttendanceSession[] @relation("SessionTeacher")
  attendanceRecords  AttendanceRecord[]
  leaveApplications  LeaveApplication[]  @relation("StudentLeaves")
  submissions        AssignmentSubmission[]
  noticesPosted      Notice[]
  uploadedFiles      UploadedFile[]
  feeInvoices        FeeInvoice[]        @relation("StudentInvoices")
  createdInvoices    FeeInvoice[]        @relation("CreatedInvoices")
  cancelledInvoices  FeeInvoice[]        @relation("CancelledInvoices")
  feeTransactions    FeeTransaction[]    @relation("StudentTransactions")
  reconciledTxns     FeeTransaction[]    @relation("ReconciledTransactions")
  performedAuditLogs FeeAuditLog[]       @relation("PerformedAuditLogs")
  assignedLeaveApprovals LeaveApplication[] @relation("AssignedApprover")
  approvedLeaveApplications LeaveApplication[] @relation("LeaveApprovedBy")
  performedLeaveAudits LeaveAuditLog[]     @relation("PerformedLeaveAudits")
  performedNoticeAudits NoticeAuditLog[]   @relation("PerformedNoticeAudits")
  noticeAcknowledgements NoticeAcknowledgement[] @relation("UserNoticeAcknowledgements")
  performedProfileAudits ProfileAuditLog[] @relation("PerformedProfileAudits")
  studentGrades        StudentGrade[]      @relation("StudentGrades")
  gradesEntered        StudentGrade[]      @relation("GradeEnteredBy")
  ticketsCreated       SupportTicket[]     @relation("StudentTickets")
  assignedTickets      SupportTicket[]     @relation("StaffAssignedTickets")
  resolvedTickets      SupportTicket[]     @relation("StaffResolvedTickets")
  closedTickets        SupportTicket[]     @relation("StaffClosedTickets")
  reopenedTickets      SupportTicket[]     @relation("StaffReopenedTickets")
  ticketMessages       TicketMessage[]     @relation("TicketMessageSender")
  ticketAudits         TicketAuditLog[]    @relation("TicketAuditActor")

  @@map("users")
}

model StudentProfile {
  id               String            @id @default(uuid())
  userId           String            @unique @map("user_id")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber       String            @unique @map("roll_number")
  registrationNo   String            @unique @map("registration_no")
  batchId          String            @map("batch_id")
  batch            Batch             @relation(fields: [batchId], references: [id])
  sectionId        String            @map("section_id")
  section          Section           @relation(fields: [sectionId], references: [id])
  currentSemester  Int               @default(1) @map("current_semester")
  currentCgpa      Decimal           @default(0.00) @map("current_cgpa") @db.Decimal(4, 2)
  mentorFacultyId  String?           @map("mentor_faculty_id")
  mentor           User?             @relation("FacultyMentor", fields: [mentorFacultyId], references: [id])
  bloodGroup       String?           @map("blood_group")
  emergencyContact String?           @map("emergency_contact")
  guardianName     String?           @map("guardian_name")
  personalEmail    String?           @map("personal_email") @db.VarChar(255)
  addressLine      String?           @map("address_line")
  city             String?           @db.VarChar(64)
  state            String?           @db.VarChar(64)
  pincode          String?           @db.VarChar(16)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime?         @default(now()) @map("updated_at")
  auditLogs        ProfileAuditLog[]

  @@map("student_profiles")
}

model FacultyProfile {
  id             String     @id @default(uuid())
  userId         String     @unique @map("user_id")
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode   String     @unique @map("employee_code")
  departmentId   String     @map("department_id")
  department     Department @relation(fields: [departmentId], references: [id])
  designation    String
  cabinLocation  String?    @map("cabin_location")
  specialization String?
  createdAt      DateTime   @default(now()) @map("created_at")

  @@map("faculty_profiles")
}

model Course {
  id             String           @id @default(uuid())
  departmentId   String           @map("department_id")
  department     Department       @relation(fields: [departmentId], references: [id])
  code           String           @unique
  title          String
  credits        Int              @default(4)
  lectureHours   Int              @default(3) @map("lecture_hours")
  tutorialHours  Int              @default(0) @map("tutorial_hours")
  practicalHours Int              @default(2) @map("practical_hours")
  syllabusDocUrl String?          @map("syllabus_doc_url")
  offerings      CourseOffering[]
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("courses")
}

model CourseOffering {
  id               String              @id @default(uuid())
  courseId         String              @map("course_id")
  course           Course              @relation(fields: [courseId], references: [id])
  sectionId        String              @map("section_id")
  section          Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  primaryFacultyId String              @map("primary_faculty_id")
  primaryFaculty   User                @relation("CourseTeacher", fields: [primaryFacultyId], references: [id])
  academicYear     String              @map("academic_year")
  semester         Int
  isActive         Boolean             @default(true) @map("is_active")
  enrollments      Enrollment[]
  timetableSlots   TimetableSlot[]
  sessions         AttendanceSession[]
  assignments      Assignment[]
  examComponents   ExamComponent[]
  createdAt        DateTime            @default(now()) @map("created_at")

  @@unique([courseId, sectionId, academicYear, semester])
  @@map("course_offerings")
}

model Enrollment {
  id               String         @id @default(uuid())
  studentId        String         @map("student_id")
  student          User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOfferingId String         @map("course_offering_id")
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  enrolledAt       DateTime       @default(now()) @map("enrolled_at")

  @@unique([studentId, courseOfferingId])
  @@map("enrollments")
}

model TimetableSlot {
  id               String              @id @default(uuid())
  courseOfferingId String              @map("course_offering_id")
  courseOffering   CourseOffering      @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  dayName          DayOfWeek           @map("day_name")
  startTime        String              @map("start_time")
  endTime          String              @map("end_time")
  roomNumber       String              @map("room_number")
  isLab            Boolean             @default(false) @map("is_lab")
  note             String?
  sessions         AttendanceSession[]
  createdAt        DateTime            @default(now()) @map("created_at")

  @@map("timetable_slots")
}

model AttendanceSession {
  id               String             @id @default(uuid())
  courseOfferingId String             @map("course_offering_id")
  courseOffering   CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  slotId           String?            @map("slot_id")
  slot             TimetableSlot?     @relation(fields: [slotId], references: [id])
  facultyId        String             @map("faculty_id")
  faculty          User               @relation("SessionTeacher", fields: [facultyId], references: [id])
  sessionDate      DateTime           @default(now()) @map("session_date")
  startTime        String             @map("start_time")
  topicTaught      String?            @map("topic_taught")
  markedAt         DateTime           @default(now()) @map("marked_at")
  isLocked         Boolean            @default(false) @map("is_locked")
  records          AttendanceRecord[]

  @@index([courseOfferingId])
  @@index([facultyId])
  @@index([sessionDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String            @map("session_id")
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String            @map("student_id")
  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus  @default(PRESENT)
  remarks   String?
  updatedAt DateTime          @default(now()) @map("updated_at")

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId])
  @@map("attendance_records")
}

model LeaveApplication {
  id                 String          @id @default(uuid())
  studentId          String          @map("student_id")
  student            User            @relation("StudentLeaves", fields: [studentId], references: [id], onDelete: Cascade)
  category           String          @default("LEAVE")
  leaveType          String          @map("leave_type")
  title              String?
  startDate          DateTime        @map("start_date") @db.Date
  endDate            DateTime        @map("end_date") @db.Date
  reason             String
  supportingDocUrl   String?         @map("supporting_doc_url")
  supportingFileKey  String?         @map("supporting_file_key")
  status             LeaveStatus     @default(PENDING)
  mentorRemarks      String?         @map("mentor_remarks")
  hodRemarks         String?         @map("hod_remarks")
  assignedApproverId String?         @map("assigned_approver_id")
  assignedApprover   User?           @relation("AssignedApprover", fields: [assignedApproverId], references: [id])
  approvedBy         String?         @map("approved_by")
  approver           User?           @relation("LeaveApprovedBy", fields: [approvedBy], references: [id])
  decisionReason     String?         @map("decision_reason")
  decidedAt          DateTime?       @map("decided_at")
  withdrawnAt        DateTime?       @map("withdrawn_at")
  withdrawalReason   String?         @map("withdrawal_reason")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @default(now()) @map("updated_at")

  auditLogs          LeaveAuditLog[]

  @@index([studentId])
  @@index([status])
  @@index([assignedApproverId])
  @@index([startDate, endDate])
  @@index([category])
  @@map("leave_applications")
}

model LeaveAuditLog {
  id             String           @id @default(uuid())
  applicationId  String           @map("application_id")
  application    LeaveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  action         String
  previousStatus String?          @map("previous_status")
  newStatus      String           @map("new_status")
  performedById  String           @map("performed_by_id")
  performedBy    User             @relation("PerformedLeaveAudits", fields: [performedById], references: [id], onDelete: Cascade)
  reason         String?
  details        Json             @default("{}")
  ipAddress      String?          @map("ip_address")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([applicationId])
  @@index([action])
  @@index([performedById])
  @@map("leave_audit_logs")
}

model Assignment {
  id               String                 @id @default(uuid())
  courseOfferingId String                 @map("course_offering_id")
  courseOffering   CourseOffering         @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  attachmentUrl    String?                @map("attachment_url")
  dueDate          DateTime               @map("due_date")
  totalMarks       Int                    @default(100) @map("total_marks")
  isPublished      Boolean                @default(true) @map("is_published")
  submissions      AssignmentSubmission[]
  createdAt        DateTime               @default(now()) @map("created_at")

  @@map("assignments")
}

model AssignmentSubmission {
  id                String                     @id @default(uuid())
  assignmentId      String                     @map("assignment_id")
  assignment        Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId         String                     @map("student_id")
  student           User                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissionFileUrl String?                    @map("submission_file_url")
  submissionText    String?                    @map("submission_text")
  submittedAt       DateTime                   @default(now()) @map("submitted_at")
  status            AssignmentSubmissionStatus @default(SUBMITTED_ON_TIME)
  score             Decimal?                   @db.Decimal(5, 2)
  feedback          String?
  gradedBy          String?                    @map("graded_by")
  gradedAt          DateTime?                  @map("graded_at")

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Notice {
  id                String                  @id @default(uuid())
  title             String
  content           String
  category          String                  @default("ACADEMIC")
  priority          String                  @default("NORMAL")
  status            NoticeStatus            @default(PUBLISHED)
  targetRole        UserRole?               @map("target_role")
  departmentId      String?                 @map("department_id")
  department        Department?             @relation(fields: [departmentId], references: [id])
  programId         String?                 @map("program_id")
  program           Program?                @relation(fields: [programId], references: [id])
  batchId           String?                 @map("batch_id")
  batch             Batch?                  @relation(fields: [batchId], references: [id])
  targetSemester    Int?                    @map("target_semester")
  isPinned          Boolean                 @default(false) @map("is_pinned")
  attachmentUrl     String?                 @map("attachment_url")
  attachmentFileKey String?                 @map("attachment_file_key")
  postedById        String                  @map("posted_by")
  postedBy          User                    @relation(fields: [postedById], references: [id])
  eventDate         DateTime?               @map("event_date")
  publishAt         DateTime?               @map("publish_at")
  publishedAt       DateTime?               @default(now()) @map("published_at")
  expiresAt         DateTime?               @map("expires_at")
  archivedAt        DateTime?               @map("archived_at")
  cancelledAt       DateTime?               @map("cancelled_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @default(now()) @map("updated_at")

  auditLogs         NoticeAuditLog[]
  acknowledgements  NoticeAcknowledgement[]

  @@map("notices")
}

model NoticeAuditLog {
  id             String       @id @default(uuid())
  noticeId       String       @map("notice_id")
  notice         Notice       @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  action         String
  previousStatus String?      @map("previous_status")
  newStatus      String       @map("new_status")
  performedById  String       @map("performed_by_id")
  performedBy    User         @relation("PerformedNoticeAudits", fields: [performedById], references: [id], onDelete: Cascade)
  reason         String?
  details        Json         @default("{}")
  ipAddress      String?      @map("ip_address")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("notice_audit_logs")
}

model NoticeAcknowledgement {
  id             String       @id @default(uuid())
  noticeId       String       @map("notice_id")
  notice         Notice       @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation("UserNoticeAcknowledgements", fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime     @default(now()) @map("acknowledged_at")

  @@unique([noticeId, userId])
  @@map("notice_acknowledgements")
}

model FeeInvoice {
  id                 String           @id @default(uuid())
  studentId          String           @map("student_id")
  student            User             @relation("StudentInvoices", fields: [studentId], references: [id], onDelete: Cascade)
  invoiceNumber      String           @unique @map("invoice_number")
  academicTerm       String           @map("academic_term")
  academicYear       String           @default("2026-27") @map("academic_year")
  semester           Int              @default(1)
  category           String
  description        String?
  subtotalAmount     Decimal          @default(0.00) @map("subtotal_amount") @db.Decimal(10, 2)
  concessionAmount   Decimal          @default(0.00) @map("concession_amount") @db.Decimal(10, 2)
  concessionReason   String?          @map("concession_reason")
  totalAmount        Decimal          @map("total_amount") @db.Decimal(10, 2)
  paidAmount         Decimal          @default(0.00) @map("paid_amount") @db.Decimal(10, 2)
  dueDate            DateTime         @map("due_date") @db.Date
  issueDate          DateTime         @default(now()) @map("issue_date") @db.Date
  status             FeePaymentStatus @default(PENDING)
  receiptUrl         String?          @map("receipt_url")
  createdById        String?          @map("created_by_id")
  createdBy          User?            @relation("CreatedInvoices", fields: [createdById], references: [id])
  cancelledAt        DateTime?        @map("cancelled_at")
  cancelledById      String?          @map("cancelled_by_id")
  cancelledBy        User?            @relation("CancelledInvoices", fields: [cancelledById], references: [id])
  cancellationReason String?          @map("cancellation_reason")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @default(now()) @map("updated_at")

  items              FeeInvoiceItem[]
  transactions       FeeTransaction[]
  auditLogs          FeeAuditLog[]

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@map("fee_invoices")
}

model FeeInvoiceItem {
  id          String     @id @default(uuid())
  invoiceId   String     @map("invoice_id")
  invoice     FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal    @db.Decimal(10, 2)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("fee_invoice_items")
}

model FeeTransaction {
  id              String        @id @default(uuid())
  invoiceId       String        @map("invoice_id")
  invoice         FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId       String?       @map("student_id")
  student         User?         @relation("StudentTransactions", fields: [studentId], references: [id], onDelete: Cascade)
  transactionRef  String        @unique @map("transaction_ref")
  paymentMode     String        @map("payment_mode")
  amount          Decimal       @db.Decimal(10, 2)
  status          String        @default("PENDING")
  gatewayProvider String?       @default("UNCONFIGURED") @map("gateway_provider")
  gatewayResponse String?       @map("gateway_response")
  receiptNumber   String?       @unique @map("receipt_number")
  reconciledById  String?       @map("reconciled_by_id")
  reconciledBy    User?         @relation("ReconciledTransactions", fields: [reconciledById], references: [id])
  reconciledAt    DateTime?     @map("reconciled_at")
  notes           String?
  paidAt          DateTime?     @default(now()) @map("paid_at")
  verificationSource String?    @default("MANUAL_STAFF_ENTRY") @map("verification_source")
  receiptKeyVersion  String?    @default("v1") @map("receipt_key_version")
  createdAt       DateTime      @default(now()) @map("created_at")
  auditLogs       FeeAuditLog[]

  @@index([invoiceId])
  @@index([studentId])
  @@index([status])
  @@map("fee_transactions")
}

model FeeAuditLog {
  id            String          @id @default(uuid())
  invoiceId     String?         @map("invoice_id")
  invoice       FeeInvoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  transactionId String?         @map("transaction_id")
  transaction   FeeTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  action        String
  performedById String          @map("performed_by_id")
  performedBy   User            @relation("PerformedAuditLogs", fields: [performedById], references: [id], onDelete: Cascade)
  details       Json            @default("{}")
  ipAddress     String?         @map("ip_address")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([action])
  @@index([performedById])
  @@map("fee_audit_logs")
}

model HostelGatePass {
  id                     String    @id @default(uuid())
  passNumber             String    @unique @map("pass_number")
  studentId              String    @map("student_id")
  passType               String    @map("pass_type")
  departureTime          DateTime  @map("departure_time")
  expectedReturn         DateTime  @map("expected_return")
  destination            String
  reason                 String
  parentConsentVerified  Boolean   @default(true) @map("parent_consent_verified")
  status                 String    @default("PENDING_WARDEN")
  wardenApprovedBy       String?   @map("warden_approved_by")
  actualOutTime          DateTime? @map("actual_out_time")
  actualInTime           DateTime? @map("actual_in_time")
  qrHash                 String?   @map("qr_hash")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@map("hostel_gate_passes")
}

model Session {
  id           String    @id @default(uuid())
  sessionToken String    @unique @map("session_token")
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @default(now()) @map("updated_at")

  @@index([userId])
  @@index([sessionToken])
  @@map("sessions")
}

model UploadedFile {
  id           String   @id @default(uuid())
  fileKey      String   @unique @map("file_key")
  originalName String   @map("original_name")
  sizeBytes    Int      @map("size_bytes")
  mimeType     String   @map("mime_type")
  uploadedById String   @map("user_id")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([uploadedById])
  @@index([fileKey])
  @@map("uploaded_files")
}

model ExamComponent {
  id               String         @id @default(uuid())
  courseOfferingId String         @map("course_offering_id")
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  name             String         @db.VarChar(64)
  maxMarks         Decimal        @default(100.00) @map("max_marks") @db.Decimal(5, 2)
  weightagePercent Decimal        @map("weightage_percent") @db.Decimal(5, 2)
  grades           StudentGrade[]

  @@map("exam_components")
}

model StudentGrade {
  id              String        @id @default(uuid())
  studentId       String        @map("student_id")
  student         User          @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)
  examComponentId String        @map("exam_component_id")
  examComponent   ExamComponent @relation(fields: [examComponentId], references: [id], onDelete: Cascade)
  obtainedMarks   Decimal       @map("obtained_marks") @db.Decimal(5, 2)
  enteredBy       String?       @map("entered_by")
  grader          User?         @relation("GradeEnteredBy", fields: [enteredBy], references: [id])
  createdAt       DateTime?     @default(now()) @map("created_at")

  @@unique([studentId, examComponentId])
  @@map("student_grades")
}

model ProfileAuditLog {
  id               String         @id @default(uuid())
  studentProfileId String         @map("student_profile_id")
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  changedById      String         @map("changed_by_id")
  changedBy        User           @relation("PerformedProfileAudits", fields: [changedById], references: [id], onDelete: Cascade)
  action           String         @db.VarChar(64)
  changedFields    Json           @default("{}") @map("changed_fields")
  previousValues   Json           @default("{}") @map("previous_values")
  newValues        Json           @default("{}") @map("new_values")
  ipAddress        String?        @map("ip_address") @db.VarChar(45)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([studentProfileId])
  @@index([changedById])
  @@index([createdAt(sort: Desc)])
  @@map("profile_audit_logs")
}

model SupportTicket {
  id               String            @id @default(uuid())
  ticketNumber     String            @unique @map("ticket_number") @db.VarChar(32)
  studentId        String            @map("student_id")
  student          User              @relation("StudentTickets", fields: [studentId], references: [id], onDelete: Cascade)
  category         String            @db.VarChar(64)
  priority         String            @default("MEDIUM") @db.VarChar(32)
  status           String            @default("OPEN") @db.VarChar(32)
  subject          String            @db.VarChar(255)
  description      String            @db.Text
  departmentId     String?           @map("department_id")
  department       Department?       @relation(fields: [departmentId], references: [id])
  assignedStaffId  String?           @map("assigned_staff_id")
  assignedStaff    User?             @relation("StaffAssignedTickets", fields: [assignedStaffId], references: [id])
  resolutionNotes  String?           @map("resolution_notes") @db.Text
  resolvedAt       DateTime?         @map("resolved_at")
  resolvedById     String?           @map("resolved_by_id")
  resolvedBy       User?             @relation("StaffResolvedTickets", fields: [resolvedById], references: [id])
  closedAt         DateTime?         @map("closed_at")
  closedById       String?           @map("closed_by_id")
  closedBy         User?             @relation("StaffClosedTickets", fields: [closedById], references: [id])
  reopenedAt       DateTime?         @map("reopened_at")
  reopenedById     String?           @map("reopened_by_id")
  reopenedBy       User?             @relation("StaffReopenedTickets", fields: [reopenedById], references: [id])
  reopenReason     String?           @map("reopen_reason") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @default(now()) @map("updated_at")

  messages         TicketMessage[]
  auditLogs        TicketAuditLog[]

  @@index([studentId])
  @@index([status])
  @@index([category])
  @@index([assignedStaffId])
  @@index([departmentId])
  @@index([createdAt(sort: Desc)])
  @@map("support_tickets")
}

model TicketMessage {
  id                 String        @id @default(uuid())
  ticketId           String        @map("ticket_id")
  ticket             SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId           String        @map("sender_id")
  sender             User          @relation("TicketMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  message            String        @db.Text
  isInternal         Boolean       @default(false) @map("is_internal")
  attachmentFileKey  String?       @map("attachment_file_key") @db.VarChar(255)
  attachmentName     String?       @map("attachment_name") @db.VarChar(255)
  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt(sort: Asc)])
  @@map("ticket_messages")
}

model TicketAuditLog {
  id                 String        @id @default(uuid())
  ticketId           String        @map("ticket_id")
  ticket             SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  performedById      String        @map("performed_by_id")
  performedBy        User          @relation("TicketAuditActor", fields: [performedById], references: [id], onDelete: Restrict)
  action             String        @db.VarChar(64)
  previousStatus     String?       @map("previous_status") @db.VarChar(32)
  newStatus          String?       @map("new_status") @db.VarChar(32)
  previousAssigneeId String?       @map("previous_assignee_id")
  newAssigneeId      String?       @map("new_assignee_id")
  reason             String?       @db.Text
  details            Json          @default("{}")
  ipAddress          String?       @map("ip_address") @db.VarChar(45)
  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@index([performedById])
  @@index([createdAt(sort: Desc)])
  @@map("ticket_audit_logs")
}

