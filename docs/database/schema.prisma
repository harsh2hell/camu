// Prisma Schema for DBS Global University Portal (DBS-Camu Next)
// Datasource & Generator

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  FACULTY
  HOD
  DEAN
  REGISTRAR_ADMIN
  EXAM_CONTROLLER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_DUTY
  MEDICAL_LEAVE
  EXEMPTED
}

enum LeaveStatus {
  PENDING
  RECOMMENDED_BY_MENTOR
  APPROVED_BY_HOD
  REJECTED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Department {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  programs    Program[]
  faculty     FacultyProfile[]
  courses     Course[]
  createdAt   DateTime  @default(now())
}

model Program {
  id                 String     @id @default(uuid())
  departmentId       String
  department         Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code               String     @unique
  name               String
  durationSemesters  Int        @default(8)
  degreeLevel        String
  batches            Batch[]
  createdAt          DateTime   @default(now())
}

model Batch {
  id              String      @id @default(uuid())
  programId       String
  program         Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  startYear       Int
  endYear         Int
  batchName       String
  currentSemester Int         @default(1)
  isActive        Boolean     @default(true)
  sections        Section[]
  students        StudentProfile[]
  notices         Notice[]
  createdAt       DateTime    @default(now())

  @@unique([programId, startYear, endYear])
}

model Section {
  id              String           @id @default(uuid())
  batchId         String
  batch           Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name            String
  students        StudentProfile[]
  courseOfferings CourseOffering[]
  createdAt       DateTime         @default(now())

  @@unique([batchId, name])
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  fullName           String              @map("full_name")
  phone              String?
  avatarUrl          String?             @map("avatar_url")
  role               UserRole            @default(STUDENT)
  passwordHash       String              @map("password_hash")
  isActive           Boolean             @default(true) @map("is_active")
  lastLoginAt        DateTime?           @map("last_login_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @default(now()) @map("updated_at")

  sessions           Session[]
  studentProfile     StudentProfile?
  facultyProfile     FacultyProfile?
  mentoredStudents   StudentProfile[]    @relation("FacultyMentor")
  taughtOfferings    CourseOffering[]    @relation("CourseTeacher")
  enrollments        Enrollment[]
  markedSessions     AttendanceSession[] @relation("SessionTeacher")
  attendanceRecords  AttendanceRecord[]
  leaveApplications  LeaveApplication[]  @relation("StudentLeaves")
  submissions        AssignmentSubmission[]
  noticesPosted      Notice[]

  @@map("users")
}

model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber       String   @unique @map("roll_number")
  registrationNo   String   @unique @map("registration_no")
  batchId          String   @map("batch_id")
  batch            Batch    @relation(fields: [batchId], references: [id])
  sectionId        String   @map("section_id")
  section          Section  @relation(fields: [sectionId], references: [id])
  currentSemester  Int      @default(1) @map("current_semester")
  currentCgpa      Decimal  @default(0.00) @map("current_cgpa") @db.Decimal(4, 2)
  mentorFacultyId  String?  @map("mentor_faculty_id")
  mentor           User?    @relation("FacultyMentor", fields: [mentorFacultyId], references: [id])
  bloodGroup       String?  @map("blood_group")
  emergencyContact String?  @map("emergency_contact")
  guardianName     String?  @map("guardian_name")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("student_profiles")
}

model FacultyProfile {
  id             String     @id @default(uuid())
  userId         String     @unique @map("user_id")
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode   String     @unique @map("employee_code")
  departmentId   String     @map("department_id")
  department     Department @relation(fields: [departmentId], references: [id])
  designation    String
  cabinLocation  String?    @map("cabin_location")
  specialization String?
  createdAt      DateTime   @default(now()) @map("created_at")

  @@map("faculty_profiles")
}

model Course {
  id             String           @id @default(uuid())
  departmentId   String           @map("department_id")
  department     Department       @relation(fields: [departmentId], references: [id])
  code           String           @unique
  title          String
  credits        Int              @default(4)
  lectureHours   Int              @default(3) @map("lecture_hours")
  tutorialHours  Int              @default(0) @map("tutorial_hours")
  practicalHours Int              @default(2) @map("practical_hours")
  syllabusDocUrl String?          @map("syllabus_doc_url")
  offerings      CourseOffering[]
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("courses")
}

model CourseOffering {
  id               String              @id @default(uuid())
  courseId         String              @map("course_id")
  course           Course              @relation(fields: [courseId], references: [id])
  sectionId        String              @map("section_id")
  section          Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  primaryFacultyId String              @map("primary_faculty_id")
  primaryFaculty   User                @relation("CourseTeacher", fields: [primaryFacultyId], references: [id])
  academicYear     String              @map("academic_year")
  semester         Int
  isActive         Boolean             @default(true) @map("is_active")
  enrollments      Enrollment[]
  timetableSlots   TimetableSlot[]
  sessions         AttendanceSession[]
  assignments      Assignment[]
  createdAt        DateTime            @default(now()) @map("created_at")

  @@unique([courseId, sectionId, academicYear, semester])
  @@map("course_offerings")
}

model Enrollment {
  id               String         @id @default(uuid())
  studentId        String         @map("student_id")
  student          User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOfferingId String         @map("course_offering_id")
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  enrolledAt       DateTime       @default(now()) @map("enrolled_at")

  @@unique([studentId, courseOfferingId])
  @@map("enrollments")
}

model TimetableSlot {
  id               String              @id @default(uuid())
  courseOfferingId String              @map("course_offering_id")
  courseOffering   CourseOffering      @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  dayName          DayOfWeek           @map("day_name")
  startTime        String              @map("start_time")
  endTime          String              @map("end_time")
  roomNumber       String              @map("room_number")
  isLab            Boolean             @default(false) @map("is_lab")
  sessions         AttendanceSession[]
  createdAt        DateTime            @default(now()) @map("created_at")

  @@map("timetable_slots")
}

model AttendanceSession {
  id               String             @id @default(uuid())
  courseOfferingId String             @map("course_offering_id")
  courseOffering   CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  slotId           String?            @map("slot_id")
  slot             TimetableSlot?     @relation(fields: [slotId], references: [id])
  facultyId        String             @map("faculty_id")
  faculty          User               @relation("SessionTeacher", fields: [facultyId], references: [id])
  sessionDate      DateTime           @default(now()) @map("session_date")
  startTime        String             @map("start_time")
  topicTaught      String?            @map("topic_taught")
  markedAt         DateTime           @default(now()) @map("marked_at")
  isLocked         Boolean            @default(false) @map("is_locked")
  records          AttendanceRecord[]

  @@index([courseOfferingId])
  @@index([facultyId])
  @@index([sessionDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String            @map("session_id")
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String            @map("student_id")
  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus  @default(PRESENT)
  remarks   String?
  updatedAt DateTime          @default(now()) @map("updated_at")

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId])
  @@map("attendance_records")
}

model LeaveApplication {
  id               String      @id @default(uuid())
  studentId        String
  student          User        @relation("StudentLeaves", fields: [studentId], references: [id], onDelete: Cascade)
  leaveType        String
  startDate        DateTime
  endDate          DateTime
  reason           String
  supportingDocUrl String?
  status           LeaveStatus @default(PENDING)
  mentorRemarks    String?
  hodRemarks       String?
  approvedBy       String?
  createdAt        DateTime    @default(now())
}

model Assignment {
  id               String                 @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering         @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  attachmentUrl    String?
  dueDate          DateTime
  totalMarks       Int                    @default(100)
  submissions      AssignmentSubmission[]
  createdAt        DateTime               @default(now())
}

model AssignmentSubmission {
  id                String     @id @default(uuid())
  assignmentId      String
  assignment        Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId         String
  student           User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissionFileUrl String
  submittedAt       DateTime   @default(now())
  score             Decimal?   @db.Decimal(5, 2)
  feedback          String?
  gradedBy          String?

  @@unique([assignmentId, studentId])
}

model Notice {
  id            String    @id @default(uuid())
  title         String
  content       String
  category      String    @default("ACADEMIC")
  targetRole    UserRole?
  batchId       String?
  batch         Batch?    @relation(fields: [batchId], references: [id])
  isPinned      Boolean   @default(false)
  attachmentUrl String?
  postedById    String
  postedBy      User      @relation(fields: [postedById], references: [id])
  createdAt     DateTime  @default(now())
}

model FeeInvoice {
  id            String           @id @default(uuid())
  studentId     String
  invoiceNumber String           @unique
  academicTerm  String
  category      String
  totalAmount   Decimal          @db.Decimal(10, 2)
  paidAmount    Decimal          @default(0.00) @db.Decimal(10, 2)
  dueDate       DateTime
  status        String           @default("PENDING")
  receiptUrl    String?
  transactions  FeeTransaction[]
  createdAt     DateTime         @default(now())
}

model FeeTransaction {
  id             String     @id @default(uuid())
  invoiceId      String
  invoice        FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transactionRef String     @unique
  paymentMode    String
  amount         Decimal    @db.Decimal(10, 2)
  paidAt         DateTime   @default(now())
}

model HostelGatePass {
  id                     String    @id @default(uuid())
  passNumber             String    @unique
  studentId              String
  passType               String
  departureTime          DateTime
  expectedReturn         DateTime
  destination            String
  reason                 String
  parentConsentVerified  Boolean   @default(true)
  status                 String    @default("PENDING_WARDEN")
  wardenApprovedBy       String?
  actualOutTime          DateTime?
  actualInTime           DateTime?
  qrHash                 String?
  createdAt              DateTime  @default(now())
}

model Session {
  id           String    @id @default(uuid())
  sessionToken String    @unique @map("session_token")
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @default(now()) @map("updated_at")

  @@index([userId])
  @@index([sessionToken])
  @@map("sessions")
}

