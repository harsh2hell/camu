# ==============================================================================
# DBS Global University Student Portal (Camu-Next)
# Environment Configuration Template (Placeholders Only - Never commit secrets!)
# ==============================================================================

# Server Environment, Host & Port
NODE_ENV=development
PORT=8000
# Internal Host Binding: Bind strictly to loopback (127.0.0.1) in production behind local reverse proxy
HOST=127.0.0.1
API_PREFIX=/api

# Reverse Proxy Configuration ('false', '1', '2', or subnet string e.g. 'loopback, linklocal')
# Set to '1' when behind Nginx, Cloudflare, or AWS ALB. Do NOT set to true blindly.
TRUST_PROXY=false

# Database Connection (PostgreSQL 15+)
# Example: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://dbs_admin:change_this_password@localhost:5432/dbs_camu?schema=public"

# Cross-Origin Resource Sharing (CORS) - Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://autonex.studio,https://student.autonex.studio,https://teacher.autonex.studio"

# Logging & Observability (debug, info, warn, error)
LOG_LEVEL=info

# JWT Secrets & Expiry (Phase 2 Preparation Placeholders)
JWT_SECRET=placeholder_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Session Cookie Configuration (HTTP-only)
SESSION_COOKIE_NAME=dbs_session
SESSION_MAX_AGE_DAYS=7

# Cryptographic Receipt Signing & Verification (Phase 6 Financial Integrity)
# In production, must be at least 16 chars and cannot contain 'placeholder'
RECEIPT_SIGNING_SECRET=change_me_to_at_least_16_characters_in_production
RECEIPT_SIGNING_KEY_VERSION=v1
# JSON string mapping historical key versions to secrets for key rotation, e.g. '{"v0":"old_secret_min_16"}'
RECEIPT_HISTORICAL_SIGNING_KEYS="{}"

# File Storage Configuration (Phase 5 File Infrastructure)
# Local directory or persistent volume mount path
UPLOAD_DIR=server/uploads
