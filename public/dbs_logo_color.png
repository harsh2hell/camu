	<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8">
  
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>404 – Page Not Found | DBS Global University</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ── BRAND COLORS (extracted from dgu.ac.in) ── */
    :root {
      --dgu-red:       #c8102e;
      --dgu-red-dark:  #a50d25;
      --dgu-navy:      #68176b;
      --dgu-navy-dark: #142038;
      --dgu-footer-bg: #1a1a2e;
      --dgu-footer-border: #2e2e4a;
      --dgu-topbar:    #c8102e;
      --dgu-white:     #ffffff;
      --dgu-light:     #f5f5f5;
      --dgu-text:      #333333;
      --dgu-muted:     #777777;
      --dgu-border:    #e0e0e0;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Poppins', sans-serif;
      background: var(--dgu-white);
      color: var(--dgu-text);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* ══ TOP UTILITY BAR ══ */
    .topbar {
      background: var(--dgu-topbar);
      padding: 6px 0;
    }
    .topbar-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .topbar a {
      color: rgba(255,255,255,0.9);
      text-decoration: none;
      font-size: 11.5px;
      font-weight: 400;
      letter-spacing: 0.02em;
      transition: color 0.2s;
    }
    .topbar a:hover { color: #fff; }
    .topbar-sep { color: rgba(255,255,255,0.3); font-size: 10px; }

    /* ══ MAIN HEADER ══ */
    .site-header {
      background: var(--dgu-navy);
      padding: 12px 0;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 3px 14px rgba(0,0,0,0.3);
    }
    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .logo-wrap {
      display: flex;
      align-items: center;
      text-decoration: none;
      flex-shrink: 0;
    }
    .logo-wrap img {
      height: 58px;
      width: auto;
      display: block;
    }
    .logo-fallback {
      display: none;
      align-items: center;
      gap: 10px;
    }
    .logo-fallback-icon {
      width: 50px; height: 50px;
      background: var(--dgu-red);
      border-radius: 6px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 17px; color: #fff;
    }
    .logo-fallback-text .name { font-size: 14px; font-weight: 700; color: #fff; line-height: 1.25; }
    .logo-fallback-text .sub  { font-size: 9.5px; color: rgba(255,255,255,0.55); letter-spacing: 0.08em; text-transform: uppercase; }

    /* Desktop nav */
    .main-nav {
      display: flex;
      align-items: center;
      gap: 2px;
    }
    .main-nav a {
      color: rgba(255,255,255,0.85);
      text-decoration: none;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 8px 9px;
      border-radius: 3px;
      white-space: nowrap;
      transition: background 0.2s, color 0.2s;
    }
    .main-nav a:hover { background: rgba(255,255,255,0.1); color: #fff; }
    .nav-cta {
      background: var(--dgu-red) !important;
      color: #fff !important;
      padding: 8px 16px !important;
      font-weight: 600 !important;
      border-radius: 4px;
      margin-left: 4px;
    }
    .nav-cta:hover { background: var(--dgu-red-dark) !important; }

    /* Hamburger */
    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 5px;
    }
    .hamburger span { display: block; width: 24px; height: 2px; background: #fff; border-radius: 2px; }

    /* Mobile nav */
    .mobile-nav { display: none; background: var(--dgu-navy-dark); padding: 8px 24px 14px; border-top: 1px solid rgba(255,255,255,0.07); }
    .mobile-nav.open { display: block; }
    .mobile-nav a { display: block; color: rgba(255,255,255,0.8); text-decoration: none; font-size: 12.5px; font-weight: 500; padding: 9px 0; border-bottom: 1px solid rgba(255,255,255,0.06); letter-spacing: 0.04em; text-transform: uppercase; }
    .mobile-nav a:last-child { border-bottom: none; }
    .mobile-nav a:hover { color: #fff; }

    /* ══ BREADCRUMB ══ */
    .breadcrumb {
      background: var(--dgu-light);
      border-bottom: 1px solid var(--dgu-border);
      padding: 9px 0;
    }
    .breadcrumb-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 24px;
      display: flex; align-items: center; gap: 7px;
      font-size: 12px; color: var(--dgu-muted);
    }
    .breadcrumb-inner a { color: var(--dgu-red); text-decoration: none; font-weight: 500; }
    .breadcrumb-inner a:hover { text-decoration: underline; }
    .bc-arrow { color: #ccc; font-size: 11px; }

    /* ══ 404 SECTION ══ */
    .error-section {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 64px 24px;
      background: #fff;
      position: relative;
      overflow: hidden;
    }
    .error-section::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background:
        radial-gradient(ellipse at 10% 90%, rgba(200,16,46,0.04) 0%, transparent 55%),
        radial-gradient(ellipse at 90% 10%, rgba(27,42,74,0.05) 0%, transparent 55%);
      pointer-events: none;
    }

    .error-container {
      position: relative;
      z-index: 1;
      max-width: 820px;
      width: 100%;
      display: flex;
      align-items: center;
      gap: 56px;
    }

    /* Left column */
    .err-left {
      flex-shrink: 0;
      text-align: center;
    }
    .err-num {
      font-size: clamp(96px, 17vw, 150px);
      font-weight: 700;
      line-height: 1;
      letter-spacing: -5px;
      color: var(--dgu-navy);
      animation: numPop 0.65s cubic-bezier(0.34,1.56,0.64,1) both;
    }
    .err-num .highlight { color: var(--dgu-red); }
    @keyframes numPop {
      from { opacity: 0; transform: scale(0.65); }
      to   { opacity: 1; transform: scale(1); }
    }
    .err-bar {
      height: 4px;
      width: 56px;
      background: var(--dgu-red);
      margin: 10px auto 0;
      border-radius: 2px;
      animation: barGrow 0.6s 0.2s ease both;
    }
    @keyframes barGrow {
      from { width: 0; opacity: 0; }
      to   { width: 56px; opacity: 1; }
    }

    /* Divider line */
    .err-vline {
      width: 1px;
      height: 200px;
      background: linear-gradient(to bottom, transparent, #ddd 30%, #ddd 70%, transparent);
      flex-shrink: 0;
    }

    /* Right column */
    .err-right {
      animation: slideRight 0.65s 0.1s ease both;
    }
    @keyframes slideRight {
      from { opacity: 0; transform: translateX(20px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    .err-badge {
      display: inline-block;
      background: rgba(200,16,46,0.08);
      color: var(--dgu-red);
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 20px;
      border: 1px solid rgba(200,16,46,0.18);
      margin-bottom: 14px;
    }
    .err-title {
      font-size: clamp(20px, 3.2vw, 28px);
      font-weight: 700;
      color: var(--dgu-navy);
      line-height: 1.3;
      margin-bottom: 12px;
    }
    .err-desc {
      font-size: 13.5px;
      color: var(--dgu-muted);
      line-height: 1.8;
      margin-bottom: 24px;
      max-width: 370px;
    }

    /* Quick explore links */
    .explore-label {
      font-size: 10.5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      color: var(--dgu-navy);
      margin-bottom: 9px;
    }
    .explore-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 26px;
    }
    .explore-tags a {
      font-size: 12px;
      font-weight: 500;
      color: var(--dgu-navy);
      background: var(--dgu-light);
      border: 1px solid var(--dgu-border);
      border-radius: 4px;
      padding: 5px 13px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .explore-tags a:hover {
      background: var(--dgu-navy);
      color: #fff;
      border-color: var(--dgu-navy);
    }

    /* CTA buttons */
    .cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 7px;
      background: var(--dgu-red); color: #fff;
      text-decoration: none; font-size: 13px; font-weight: 600;
      padding: 11px 22px; border-radius: 5px; border: 2px solid var(--dgu-red);
      transition: all 0.25s; letter-spacing: 0.02em;
    }
    .btn-primary:hover {
      background: var(--dgu-red-dark); border-color: var(--dgu-red-dark);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(200,16,46,0.3);
    }
    .btn-outline {
      display: inline-flex; align-items: center; gap: 7px;
      background: transparent; color: var(--dgu-navy);
      text-decoration: none; font-size: 13px; font-weight: 600;
      padding: 11px 22px; border-radius: 5px; border: 2px solid var(--dgu-navy);
      transition: all 0.25s; letter-spacing: 0.02em;
    }
    .btn-outline:hover {
      background: var(--dgu-navy); color: #fff;
      transform: translateY(-2px);
    }

    /* ══ CONTACT STRIP ══ */
    .contact-strip {
      background: var(--dgu-light);
      border-top: 1px solid var(--dgu-border);
      padding: 16px 0;
    }
    .contact-strip-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 24px;
      display: flex; align-items: center; justify-content: center;
      gap: 36px; flex-wrap: wrap;
    }
    .c-item {
      display: flex; align-items: center; gap: 9px;
      font-size: 12.5px; color: var(--dgu-text);
    }
    .c-icon {
      width: 30px; height: 30px;
      background: var(--dgu-red); border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 12px; flex-shrink: 0;
    }
    .c-item a { color: var(--dgu-red); text-decoration: none; font-weight: 500; }
    .c-item a:hover { text-decoration: underline; }

    /* ══ FOOTER ══ */
    .site-footer {
      background: var(--dgu-footer-bg);
      padding: 46px 0 0;
    }
    .footer-grid {
      max-width: 1200px; margin: 0 auto; padding: 0 24px;
      display: grid;
      grid-template-columns: 1.7fr 1fr 1fr 1fr;
      gap: 36px;
    }

    /* Brand column */
    .f-brand {}
    .f-logo img {
      height: 52px; width: auto; display: block; margin-bottom: 18px;
    }
    .f-logo-fallback {
      display: none; align-items: center; gap: 10px; margin-bottom: 18px;
    }
    .f-logo-icon {
      width: 42px; height: 42px; background: var(--dgu-red); border-radius: 5px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 14px; color: #fff;
    }
    .f-logo-name { font-size: 13px; font-weight: 700; color: #fff; line-height: 1.3; }
    .f-logo-sub  { font-size: 9px; color: rgba(255,255,255,0.45); letter-spacing: 0.07em; text-transform: uppercase; }

    .f-addr {
      font-size: 12px; color: rgba(255,255,255,0.5); line-height: 1.85; margin-bottom: 14px;
    }
    .f-addr strong {
      display: block; font-size: 10.5px; letter-spacing: 0.07em; text-transform: uppercase;
      color: rgba(255,255,255,0.7); margin-bottom: 3px;
    }
    .f-contacts a {
      display: block; color: rgba(255,255,255,0.55); text-decoration: none;
      font-size: 12px; margin-bottom: 5px; transition: color 0.2s;
    }
    .f-contacts a:hover { color: #fff; }

    /* Link columns */
    .f-col h4 {
      font-size: 11px; font-weight: 600; letter-spacing: 0.09em;
      text-transform: uppercase; color: rgba(255,255,255,0.88);
      margin-bottom: 15px; padding-bottom: 9px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .f-col ul { list-style: none; }
    .f-col ul li { margin-bottom: 7px; }
    .f-col ul li a {
      color: rgba(255,255,255,0.48); text-decoration: none; font-size: 12px;
      display: flex; align-items: center; gap: 5px; transition: color 0.2s;
    }
    .f-col ul li a::before { content: '›'; color: var(--dgu-red); font-size: 14px; }
    .f-col ul li a:hover { color: rgba(255,255,255,0.88); }

    /* Footer bottom */
    .footer-bottom-wrap {
      border-top: 1px solid var(--dgu-footer-border);
      margin-top: 38px;
    }
    .footer-bottom {
      max-width: 1200px; margin: 0 auto; padding: 15px 24px;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 10px;
    }
    .f-copy { font-size: 11.5px; color: rgba(255,255,255,0.3); }
    .f-bottom-links { display: flex; gap: 16px; flex-wrap: wrap; }
    .f-bottom-links a {
      font-size: 11.5px; color: rgba(255,255,255,0.3);
      text-decoration: none; transition: color 0.2s;
    }
    .f-bottom-links a:hover { color: rgba(255,255,255,0.65); }

    /* ══ RESPONSIVE ══ */
    @media (max-width: 900px) {
      .main-nav { display: none; }
      .hamburger { display: flex; }
      .error-container { flex-direction: column; gap: 28px; align-items: center; text-align: center; }
      .err-vline { display: none; }
      .err-right { animation: slideUp 0.65s 0.1s ease both; }
      @keyframes slideUp {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .err-desc { max-width: 100%; }
      .cta-row, .explore-tags { justify-content: center; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 580px) {
      .topbar-inner { justify-content: center; gap: 10px; }
      .footer-grid { grid-template-columns: 1fr; }
      .footer-bottom { justify-content: center; text-align: center; }
      .contact-strip-inner { flex-direction: column; gap: 12px; align-items: flex-start; }
      .err-num { letter-spacing: -2px; }
    }
  </style>
</head>
<body>

  <!-- TOP UTILITY BAR -->
  <div class="topbar">
    <div class="topbar-inner">
      <a href="https://alumni.doonbusinessschool.com">Alumni</a>
      <span class="topbar-sep">|</span>
      <a href="https://dgu.ac.in/news&filter=campus">Events</a>
      <span class="topbar-sep">|</span>
      <a href="https://walkinside.s3.ap-south-1.amazonaws.com/dbs/index.html">Virtual Tour</a>
      <span class="topbar-sep">|</span>
      <a href="https://dgu.ac.in/video-gallery">Video Gallery</a>
      <span class="topbar-sep">|</span>
      <a href="https://dbxincubator.com">DBX</a>
      <span class="topbar-sep">|</span>
      <a href="https://dgu.ac.in/contacts">Contact Us</a>
    </div>
  </div>

  <!-- MAIN HEADER -->
  <header class="site-header">
    <div class="header-inner">

      <a href="https://dgu.ac.in" class="logo-wrap" title="DBS Global University – Home">
        <img src="https://dgu.ac.in/images/logo-img.png"
             alt="DBS Global University"
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
        <div class="logo-fallback">
          <div class="logo-fallback-icon">DG</div>
          <div class="logo-fallback-text">
            <div class="name">DBS Global University</div>
            <div class="sub">Dehradun, Uttarakhand</div>
          </div>
        </div>
      </a>

      <nav class="main-nav" aria-label="Primary">
        <a href="https://dgu.ac.in/dgu-at-glance">Overview</a>
        <a href="https://dgu.ac.in/faculties">Academics</a>
        <a href="https://dgu.ac.in/school-of-business">Programs</a>
        <a href="https://dgu.ac.in/admission-process">Admission</a>
        <a href="https://dgu.ac.in/office-of-international-affairs">International</a>
        <a href="https://dgu.ac.in/overview">Life at DGU</a>
        <a href="https://dgu.ac.in/placement-reports">Placements</a>
        <a href="https://admissions.dgu.ac" class="nav-cta">Apply Now</a>
      </nav>

      <button class="hamburger" id="ham" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

    <nav class="mobile-nav" id="mobileNav" aria-label="Mobile">
      <a href="https://dgu.ac.in/dgu-at-glance">Overview</a>
      <a href="https://dgu.ac.in/faculties">Academics</a>
      <a href="https://dgu.ac.in/school-of-business">Programs</a>
      <a href="https://dgu.ac.in/admission-process">Admission</a>
      <a href="https://dgu.ac.in/office-of-international-affairs">International</a>
      <a href="https://dgu.ac.in/overview">Life at DGU</a>
      <a href="https://dgu.ac.in/placement-reports">Placements</a>
      <a href="https://admissions.dgu.ac">Apply Now →</a>
    </nav>
  </header>

  <!-- BREADCRUMB -->
  <div class="breadcrumb" aria-label="Breadcrumb">
    <div class="breadcrumb-inner">
      <a href="https://dgu.ac.in">Home</a>
      <span class="bc-arrow">›</span>
      <span>404 – Page Not Found</span>
    </div>
  </div>

  <!-- 404 CONTENT -->
  <main class="error-section" role="main" aria-label="Error 404">
    <div class="error-container">

      <!-- Big number -->
      <div class="err-left">
        <div class="err-num">4<span class="highlight">0</span>4</div>
        <div class="err-bar"></div>
      </div>

      <div class="err-vline" aria-hidden="true"></div>

      <!-- Message -->
      <div class="err-right">
        <span class="err-badge">Page Not Found</span>
        <h1 class="err-title">Oops! This page has<br>left the campus.</h1>
        <p class="err-desc">
          The page you're looking for may have been moved, renamed, or removed.
          Don't worry — your path to great education continues below.
        </p>

        <p class="explore-label">Explore DGU</p>
        <div class="explore-tags">
          <a href="https://dgu.ac.in/school-of-business">Business School</a>
          <a href="https://dgu.ac.in/school-of-technology">Computing</a>
          <a href="https://dgu.ac.in/school-of-law">Law</a>
          <a href="https://dgu.ac.in/school-of-pharmacy">Pharmacy</a>
          <a href="https://dgu.ac.in/school-of-modern-media">Media</a>
          <a href="https://dgu.ac.in/placement-reports">Placements</a>
          <a href="https://dgu.ac.in/scholarships">Scholarships</a>
        </div>

        <div class="cta-row">
          <a href="https://dgu.ac.in" class="btn-primary">← Back to Homepage</a>
          <a href="https://admissions.dgu.ac" class="btn-outline">Apply Now</a>
        </div>
      </div>

    </div>
  </main>

  <!-- CONTACT STRIP -->
  <div class="contact-strip">
    <div class="contact-strip-inner">
      <div class="c-item">
        <div class="c-icon">📍</div>
        <span>Mi-122, Behind Pharma City, Selaqui, Dehradun – 248011</span>
      </div>
      <div class="c-item">
        <div class="c-icon">📞</div>
        <a href="tel:+917259162060">+91 72591 62060</a>
      </div>
      <div class="c-item">
        <div class="c-icon">✉</div>
        <a href="/cdn-cgi/l/email-protection#b0d1d4ddd9c3c3d9dfdec3f0d4dfdfded2c5c3d9ded5c3c3d3d8dfdfdc9ed3dfdd"><span class="__cf_email__" data-cfemail="3253565f5b41415b5d5c4172565d5d5c5047415b5c574141515a5d5d5e1c515d5f">[email&#160;protected]</span></a>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="site-footer" role="contentinfo">
    <div class="footer-grid">

      <!-- Brand & address -->
      <div class="f-brand">
        <div class="f-logo">
          <img src="https://dgu.ac.in/images/dgu-logo.png"
               alt="DBS Global University"
               onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
          <div class="f-logo-fallback">
            <div class="f-logo-icon">DG</div>
            <div>
              <div class="f-logo-name">DBS Global University</div>
              <div class="f-logo-sub">Dehradun, Uttarakhand</div>
            </div>
          </div>
        </div>
        <div class="f-addr">
          <strong>Campus</strong>
          Mi-122, Behind Pharma City, Selaqui,<br>
          Dehradun, Uttarakhand – 248011
        </div>
        <div class="f-addr">
          <strong>City Office</strong>
          54 Subhash Road, Dehradun – 248001
        </div>
